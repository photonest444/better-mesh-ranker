users_cache.json

# --- node / electron ---
node_modules/
desktop/node_modules/
desktop/dist/
desktop/out/
npm-debug.log*
yarn-error.log*

# Собранное нативное ядро (его делает npm run rust)
desktop/bin/
rust/target/

# Собранные копии общего кода (их делает npm run sync / задача syncSharedUi)
desktop/src/renderer/
desktop/src/core/
android/app/src/main/assets/ui/
android/app/src/main/assets/core/

# --- preview / dev artifacts ---
.preview/
*.log

