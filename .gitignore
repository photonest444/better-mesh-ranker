.gradle/
android/.gradle/
android/local.properties
android/build/
android/app/build/
android/captures/
*.apk
*.aab
*.keystore
*.jks
android/.idea/
*.iml

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- editors / os ---
.idea/
.vscode/
.DS_Store
Thumbs.db

