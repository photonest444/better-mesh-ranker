<?xml version="1.0" encoding="utf-8"?>
<!-- Токен и кэши не выгружаются в резервные копии и не переносятся на другое устройство -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mesh_session.xml" />
        <exclude domain="sharedpref" path="mesh_cache.xml" />
        <exclude domain="sharedpref" path="mesh_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mesh_session.xml" />
        <exclude domain="sharedpref" path="mesh_cache.xml" />
    </device-transfer>
</data-extraction-rules>
